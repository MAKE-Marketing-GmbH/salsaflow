{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/index.ts": {
      "maxDuration": 10,
      "includeFiles": "db/seed/public-schedule.json"
    }
  },
  "redirects": [
    {
      "source": "/shows",
      "destination": "/shows-animationen",
      "permanent": true
    },
    {
      "source": "/events-workshops",
      "destination": "/events",
      "permanent": true
    },
    {
      "source": "/kursplan-buchung",
      "destination": "/kursplan",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/buchung/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/buchung/(.*)",
      "destination": "/buchung"
    }
  ]
}
