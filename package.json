{
  "name": "salsaflow-dc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Salsaflow Dance Company - Backend + DB + Auth (Marathon Etappe 5)",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts && npm run db:migrate && npm run db:seed",
    "setup": "npm run db:migrate && npm run db:seed",
    "verify": "tsx scripts/verify.ts",
    "verify:admin": "tsx scripts/verify-admin.ts",
    "verify:public": "tsx scripts/verify-public.ts",
    "verify:booking": "tsx scripts/verify-booking.ts",
    "verify:payment": "tsx scripts/verify-payment.ts",
    "verify:contact": "tsx scripts/verify-contact.ts",
    "verify:seo": "node scripts/verify-seo.mjs",
    "verify:umlaut": "node scripts/verify-umlaut.cjs",
    "dev:pay:api": "PAYMENT_ENABLED=1 tsx watch server/index.ts",
    "dev:pay": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:pay:api\" \"npm:dev:web\""
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@fontsource/afacad": "^5.2.10",
    "@fontsource/bricolage-grotesque": "^5.2.10",
    "@hono/node-server": "^1.14.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "framer-motion": "^12.42.2",
    "hono": "^4.7.2",
    "lenis": "^1.3.25",
    "lucide-react": "^1.23.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^22.13.1",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.30.4",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
