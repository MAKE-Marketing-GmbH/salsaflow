# --- Datenbank ---
# Leer lassen = lokale eingebettete Postgres-DB (PGlite) unter ./.data/pglite (kein Docker noetig).
# Fuer Supabase/Neon spaeter: echte Postgres-Verbindung eintragen, gleicher Code/gleiches Schema.
# DATABASE_URL=postgresql://user:pass@host:5432/salsaflow

# --- Auth ---
# Secret fuer die Session-Signatur (HMAC). In Produktion zwingend setzen.
AUTH_SECRET=dev-insecure-secret-bitte-aendern
# Startpasswort fuer den geseedeten Admin-Account (admin@salsaflow-dc.com).
SEED_ADMIN_PASSWORD=salsaflow-admin-2026

# --- API ---
API_PORT=8787

# --- Zahlung (Etappe 9) ---
# PAYMENT_ENABLED=1 schaltet die Online-Zahlung scharf: eine Buchung bleibt dann reserviert
# (pending_payment), bis der verifizierte Webhook sie bestaetigt. Leer/0 = E8-Verhalten
# (Buchung wird ohne Zahlung sofort bestaetigt - nur fuer lokale Buchungstests).
PAYMENT_ENABLED=
# Ohne STRIPE_SECRET_KEY laeuft der lokale Sandbox-Treiber (gehostete Test-Bezahlseite,
# Webhook-Events lokal signiert). Fuer echtes Stripe (Testmodus oder Live): beide Keys setzen.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Basis-URL fuer success_url / cancel_url + Sandbox-Bezahlseite (Default: http://localhost:5173).
# PUBLIC_BASE_URL=http://localhost:5173

# --- Mailversand (Etappe 8/9/14) ---
# Genutzt fuer Buchungsbestaetigungen (E8/E9) UND das Kontaktformular (E14, Mail an info@).
# Ohne RESEND_API_KEY werden Mails lokal als .eml unter ./.data/outbox geschrieben (kein echter
# Versand, lokal verifizierbar). Echter Versand = Launch-Config: nur den Key setzen.
# RESEND_API_KEY=re_...

# Eventfrog: oeffentlicher Salsaflow-Organizer-/Ticketshop-Link. Setzt alle "Tickets"-Buttons.
# Leer/ungesetzt -> Fallback auf https://eventfrog.ch (generische Startseite). Vor Launch mit dem
# echten Salsaflow-Eventfrog-Link von Fabio fuellen (Open Q9), analog STRIPE_SECRET_KEY.
VITE_EVENTFROG_URL=
